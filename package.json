{
  "name": "test",
  "private": true,
  "version": "0.5.0-beta",
  "description": "NKC serverless secure chat desktop app",
  "author": {
    "name": "NyuKoP",
    "email": "nyukop@users.noreply.github.com"
  },
  "repository": "https://github.com/NyuKoP/NKC",
  "license": "GPL-3.0-only",
  "type": "commonjs",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "cross-env VITE_DEV_SERVER_URL=http://localhost:5173 vite dev",
    "generate:onion-pins": "node scripts/generateOnionPins.mjs",
    "update:tor-pins": "node scripts/updateTorPins.mjs",
    "generate:icons": "node scripts/generateAppIcon.mjs",
    "lint:encoding": "node scripts/check-utf8.mjs",
    "build:native": "node scripts/build-go-worker.mjs",
    "build": "npm run build:native && cross-env BROWSERSLIST_IGNORE_OLD_DATA=1 tsc -b && cross-env BROWSERSLIST_IGNORE_OLD_DATA=1 vite build",
    "dist": "npm run build && electron-builder --publish never",
    "dist:win": "npm run generate:icons && npm run test:security:rollback && electron-builder --win nsis --publish never",
    "dist:mac": "npm run build && electron-builder --mac dmg zip --publish never",
    "dist:linux": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --linux AppImage deb --publish never",
    "lint": "eslint .",
    "lint:anti-slop": "oxlint --config .oxlintrc.json .",
    "preview": "vite preview",
    "start": "node scripts/start-electron.cjs",
    "analyze:router-errors": "node scripts/analyze-router-errors.cjs",
    "test:security:rollback": "node -e \"console.error('Release blocked: private security qualification required'); process.exit(1)\""
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-tabs": "^1.1.4",
    "dexie": "^4.0.8",
    "electron-updater": "^6.8.9",
    "libsodium-wrappers": "^0.7.13",
    "libsodium-wrappers-sumo": "^0.7.13",
    "lucide-react": "^0.471.0",
    "openpgp": "^6.3.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ws": "^8.21.0",
    "yjs": "^13.6.22",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@eslint/js": "^9.39.5",
    "@oxlint/plugins": "1.87.0",
    "@playwright/test": "^1.57.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.1.0",
    "electron": "43.7.8",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "oxlint": "1.87.0",
    "playwright": "^1.57.0",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.2.4",
    "vite-plugin-electron": "^0.29.0",
    "vitest": "5.0.2"
  },
  "build": {
    "appId": "com.nyukop.nkc",
    "productName": "NKC",
    "asar": true,
    "forceCodeSigning": false,
    "afterPack": "scripts/afterPack.cjs",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json",
      "LICENSE"
    ],
    "extraResources": [
      {
        "from": "native/bin",
        "to": "native",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "extraMetadata": {
      "main": "dist-electron/main.js"
    },
    "publish": {
      "provider": "github",
      "owner": "NyuKoP",
      "repo": "NKC"
    },
    "win": {
      "icon": "icon.ico",
      "signAndEditExecutable": true,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "mac": {
      "hardenedRuntime": true,
      "identity": null,
      "notarize": false,
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.social-networking"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "maintainer": "NyuKoP <nyukop@users.noreply.github.com>"
    }
  }
}
